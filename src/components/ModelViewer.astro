---
import { withBase } from '../lib/site';

interface Props {
  src: string;
  alt: string;
  poster?: string;
  compact?: boolean;
}

const { src, alt, poster = '', compact = false } = Astro.props;
---

<model-viewer
  class:list={[
    'model-viewer block w-full bg-[radial-gradient(circle_at_50%_38%,color-mix(in_srgb,var(--accent)_18%,var(--surface)),var(--surface)_62%)]',
    compact ? 'pointer-events-none aspect-[4/3]' : 'min-h-[28rem] rounded-lg',
  ]}
  src={withBase(src)}
  poster={poster ? withBase(poster) : undefined}
  alt={alt}
  camera-controls={!compact}
  touch-action="pan-y"
  auto-rotate
  auto-rotate-delay="1200"
  rotation-per-second="18deg"
  shadow-intensity="1"
  environment-image="neutral"
  loading={compact ? 'lazy' : 'eager'}
  reveal="auto"
>
  <span slot="progress-bar" class="sr-only">Loading 3D model</span>
</model-viewer>

<script>
  import '@google/model-viewer';
</script>
