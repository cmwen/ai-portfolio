---
import PageHeader from '../components/PageHeader.astro';
import WorkGrid from '../components/WorkGrid.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/site';
import { getFeaturedWorks } from '../lib/works';
import ModelViewer from '../components/ModelViewer.astro';

const featuredWorks = await getFeaturedWorks();
const leadWork = featuredWorks[0];
---

<BaseLayout>
  <section
    class="mx-auto grid max-w-7xl items-end gap-10 px-5 py-14 lg:grid-cols-[1.05fr_0.95fr] lg:px-8 lg:py-20"
  >
    <div>
      <p
        class="text-sm font-semibold uppercase tracking-[0.22em] text-[var(--accent-ink)]"
      >
        Min Wen's AI collection
      </p>
      <h1 class="mt-5 text-5xl font-semibold leading-none md:text-7xl">
        AI-made work, collected without the clutter.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-[var(--muted)]">
        A growing collection of visual design, media, experiments, and
        interactive 3D models—made with AI and kept easy to explore.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          class="focus-ring rounded-full bg-[var(--ink)] px-5 py-3 text-sm font-semibold text-[var(--bg)]"
          href={withBase('/designs/')}
        >
          View designs
        </a>
        <a
          class="focus-ring rounded-full border border-[var(--line)] bg-[var(--surface)] px-5 py-3 text-sm font-semibold"
          href={withBase('/contents/')}
        >
          View contents
        </a>
        <a
          class="focus-ring rounded-full border border-[var(--line)] bg-[var(--surface)] px-5 py-3 text-sm font-semibold"
          href={withBase('/models/')}
        >
          Explore 3D
        </a>
      </div>
    </div>
    {
      leadWork && (
        <a
          class="focus-ring group relative block overflow-hidden rounded-lg border border-[var(--line)] bg-[var(--surface)] shadow-2xl"
          href={withBase(`/works/${leadWork.data.slug}/`)}
        >
          {leadWork.data.type === 'model' && leadWork.data.modelUrl ? (
            <ModelViewer
              src={leadWork.data.modelUrl}
              alt={
                leadWork.data.thumbnailAlt ||
                `3D preview of ${leadWork.data.title}`
              }
              poster={leadWork.data.thumbnail}
              compact
            />
          ) : leadWork.data.heroImage || leadWork.data.thumbnail ? (
            <img
              class="aspect-[4/5] w-full object-cover transition duration-700 group-hover:scale-[1.02]"
              src={withBase(leadWork.data.heroImage || leadWork.data.thumbnail)}
              alt={leadWork.data.heroImageAlt || leadWork.data.thumbnailAlt}
              loading="eager"
              decoding="async"
            />
          ) : null}
          <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 to-transparent p-5 pt-16 text-sm font-semibold text-white">
            {leadWork.data.title}
          </span>
        </a>
      )
    }
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-16 lg:px-8 lg:pb-24">
    <div
      class="mb-8 flex flex-col justify-between gap-4 md:flex-row md:items-end"
    >
      <div>
        <p
          class="text-sm font-semibold uppercase tracking-[0.22em] text-[var(--accent-ink)]"
        >
          Latest records
        </p>
        <h2 class="mt-3 text-3xl font-semibold md:text-4xl">
          Selected AI artifacts
        </h2>
      </div>
      <a
        class="focus-ring rounded-full border border-[var(--line)] px-4 py-2 text-sm font-medium hover:border-[var(--accent)]"
        href={withBase('/works/')}
      >
        Browse all
      </a>
    </div>
    <WorkGrid works={featuredWorks} />
  </section>

  <PageHeader
    eyebrow="Low-friction workflow"
    title="Upload once, let the portfolio do the sorting."
    description="Add images, YouTube work, or GLB models with useful metadata. The publishing pipeline prepares each item for its section and creates the portfolio record automatically."
  />
</BaseLayout>
